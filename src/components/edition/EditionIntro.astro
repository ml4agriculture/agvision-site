---
import type { Edition } from '../../lib/edition-schema';
interface Props {
  year: number;
  notice?: Edition['notice'];
  sections: { id: string; label: string }[];
}
const { year, notice, sections } = Astro.props;
---
<section class="edition-intro" aria-label="Edition status and page navigation">
  {notice && <div class="draft-notice"><strong>{notice.title}</strong><p>{notice.text}</p></div>}
  <nav class="edition-navigation" aria-label={`${year} page sections`}>
    {sections.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
  </nav>
</section>
