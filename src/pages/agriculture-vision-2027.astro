---
import Workshop from '../layouts/Workshop.astro';

// Keep unreleased editions separate from snapshot.json: that file supplies the
// current homepage, archive routes, and public search index.
const page = {
  path: '/agriculture-vision-2027',
  title: 'Agriculture-Vision 2027 — Proposed workshop',
  description: 'A preview of the proposed 8th Agriculture-Vision workshop, exploring spatial intelligence and embodied AI in agriculture. Acceptance is pending.',
  html: '',
  source: '',
  noIndex: true,
};

const editions = [2026, 2025, 2024, 2023, 2022, 2021, 2020];
const focusAreas = [
  {
    title: 'Understanding agricultural spaces',
    text: 'Spatial intelligence, 3D scene representations and world models, including neural radiance fields and Gaussian splatting; analysis of agricultural imagery across space and time.',
  },
  {
    title: 'Connecting perception to action',
    text: 'Embodied AI, vision-language-action models, and transfer from simulation to real agricultural environments, connecting visual understanding with robotic systems.',
  },
  {
    title: 'Learning across data and environments',
    text: 'Multimodal foundation models, sensor and data fusion, and resources and benchmarks for agricultural vision, alongside other novel applications in agriculture.',
  },
];
---

<Workshop page={page}>
  <section class="edition-hero" aria-labelledby="edition-title">
    <div class="hero-inner">
      <p class="edition-label">Agriculture-Vision 2027</p>
      <h1 id="edition-title"><span>The 8th International Workshop on</span> Agriculture-Vision: Challenges &amp; Opportunities for Computer Vision in Agriculture</h1>
      <p class="edition-theme">Spatial Intelligence in Agriculture</p>
      <p class="edition-context">Proposed for IEEE/CVF CVPR 2027 · Acceptance pending</p>
    </div>
  </section>

  <section class="edition-intro" aria-label="Draft status and page navigation">
    <div class="draft-notice">
      <strong>2027 edition preview</strong>
      <p>This workshop has been proposed for CVPR 2027. Acceptance and the workshop date have not yet been confirmed.</p>
    </div>
    <nav class="edition-navigation" aria-label="2027 page sections">
      <a href="#overview">Overview</a>
      <a href="#research-focus">Research focus</a>
      <a href="#past-editions">Past editions</a>
    </nav>
  </section>

  <section class="edition-overview" id="overview" aria-labelledby="overview-title">
    <div class="overview-copy">
      <p class="section-label">The proposed 2027 edition</p>
      <h2 id="overview-title">From visual understanding to physical action</h2>
      <p>Agriculture-Vision brings computer vision research into conversation with the challenges of agriculture. The proposed eighth edition focuses on spatial intelligence and embodied AI: how machines can understand agricultural environments and use that understanding to act within them.</p>
      <p>From crop monitoring to robotic harvesting and autonomous navigation, agricultural systems must work with complex plant structures, occlusion, and changing field conditions. The proposed research scope connects 3D representations, multimodal learning, and robotics with these practical challenges.</p>
      <a class="archive-button" href="/agriculture-vision-2026">Explore the 2026 edition</a>
    </div>
    <aside class="edition-status" aria-labelledby="status-title">
      <h2 id="status-title">Workshop status</h2>
      <dl>
        <div><dt>Edition</dt><dd>8th · 2027</dd></div>
        <div><dt>Proposal</dt><dd>Submitted to CVPR 2027</dd></div>
        <div><dt>Acceptance</dt><dd>Pending</dd></div>
        <div><dt>Workshop date</dt><dd>To be confirmed</dd></div>
      </dl>
      <p>The <a href="https://cvpr.thecvf.com/Conferences/2027/CallForWorkshops">CVPR call for workshops</a> lists proposal notifications by <time datetime="2026-12-22">22 December 2026</time>.</p>
    </aside>
  </section>

  <section class="edition-focus" id="research-focus" aria-labelledby="focus-title">
    <div class="section-heading">
      <p class="section-label">Research focus</p>
      <h2 id="focus-title">Spatial intelligence in the field</h2>
      <p>The proposed scope spans computer vision methods and their use in agriculture.</p>
    </div>
    <div class="focus-areas">
      {focusAreas.map(({ title, text }) => <div class="focus-area">
        <h3>{title}</h3>
        <p>{text}</p>
      </div>)}
    </div>
    <p class="participation-note">Program and participation details will be announced after workshop acceptance.</p>
  </section>

  <section class="edition-archive" id="past-editions" aria-labelledby="archive-title">
    <div class="section-heading">
      <p class="section-label">Workshop archive</p>
      <h2 id="archive-title">Explore past editions</h2>
      <p>Browse the workshop series, from its first edition in 2020 through 2026.</p>
    </div>
    <ul class="edition-years">
      {editions.map((year) => <li><a href={`/agriculture-vision-${year}`} aria-label={`Agriculture-Vision ${year}`}>{year}</a></li>)}
    </ul>
    <p class="archive-note">Calls for papers, schedules, and participation details in the archive belong to their original editions.</p>
  </section>
</Workshop>

<style>
  /* All new styles are scoped to this edition; the shared archive theme stays intact. */
  :global(body[data-route='/agriculture-vision-2027'] .site-header:not(.is-scrolled)) {
    background: #212121;
  }
  section.edition-hero {
    background: linear-gradient(#161c19b8, #161c19d1), url('/media/57525b0cc9604731bb64.png') center / cover;
    color: #fff;
    padding: 104px 24px 48px;
    text-align: center;
  }
  .hero-inner { max-width: 900px; margin-inline: auto; }
  .edition-label, .section-label { font-size: .82rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .edition-label { color: #eee; }
  h1#edition-title { font: 400 clamp(1.8rem, 3.4vw, 2.65rem)/1.2 var(--heading); text-transform: uppercase; margin: 20px auto; text-wrap: balance; }
  #edition-title span { display: block; font: 400 1.05rem/1.5 var(--body); text-transform: none; margin-bottom: 10px; }
  p.edition-theme { font: 400 clamp(1.25rem, 2vw, 1.6rem)/1.4 var(--heading); margin-top: 26px; }
  p.edition-context { font-size: .88rem; color: #eee; margin-top: 10px; }
  section.edition-intro { padding-top: 28px; padding-bottom: 0; }
  .draft-notice { display: flex; align-items: baseline; gap: 12px 24px; padding: 18px 22px; border-left: 4px solid var(--accent); background: var(--shade); font-size: .9rem; }
  .draft-notice strong { flex-shrink: 0; }
  .draft-notice p { margin: 0; }
  .edition-navigation { display: flex; flex-wrap: wrap; gap: 8px 28px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .edition-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: .9rem; font-weight: 600; }
  section.edition-overview { display: grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); gap: clamp(32px, 6vw, 80px); padding-top: 48px; padding-bottom: 56px; }
  .section-label { color: var(--muted); margin-bottom: 10px; }
  .overview-copy h2, .section-heading h2 { font-weight: 400; font-size: 2rem; text-wrap: balance; margin: 0 0 20px; }
  .overview-copy p:not(.section-label) { max-width: 68ch; margin-bottom: 16px; }
  .archive-button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 22px; margin-top: 10px; border-radius: 3px; color: #fff; background: var(--action); text-decoration: none; font-size: .9rem; }
  .archive-button:hover { color: #fff; background: #972f2f; }
  .edition-status { align-self: start; background: var(--shade); padding: 26px; border-top: 3px solid var(--accent); }
  .edition-status h2 { font-size: 1.35rem; margin: 0 0 18px; }
  .edition-status dl { margin: 0 0 20px; }
  .edition-status dl div { padding: 10px 0; border-bottom: 1px solid var(--line); }
  .edition-status dt { font-size: .82rem; color: var(--muted); }
  .edition-status dd { margin: 2px 0 0; font-weight: 600; font-size: .94rem; }
  .edition-status p { font-size: .82rem; }
  section.edition-focus { background: var(--shade); padding-top: 48px; padding-bottom: 48px; }
  .section-heading { max-width: 720px; }
  .focus-areas { margin-top: 30px; border-top: 1px solid #ccc; }
  .focus-area { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(0, 2fr); gap: 32px; padding: 24px 0; border-bottom: 1px solid #ccc; }
  .focus-area h3 { font-size: 1.35rem; margin: 0; font-weight: 400; }
  .focus-area p { margin: 0; max-width: 70ch; }
  p.participation-note { color: #505050; font-size: .9rem; margin-top: 26px; }
  section.edition-archive { padding-top: 48px; padding-bottom: 56px; }
  .edition-years { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; padding: 0; margin: 28px 0 20px; }
  .edition-years li { margin: 0; }
  .edition-years a { display: flex; align-items: center; justify-content: center; min-width: 94px; min-height: 54px; border: 1px solid #b9b9b9; border-radius: 3px; font-weight: 600; text-decoration: none; }
  .edition-years a:hover { background: var(--shade); border-color: var(--accent); text-decoration: underline; }
  .archive-note { color: var(--muted); font-size: .85rem; }
  @media (max-width: 767px) {
    section.edition-hero { padding: 88px 20px 36px; }
    .draft-notice { display: block; padding: 16px 18px; }
    .draft-notice strong { display: block; margin-bottom: 6px; }
    .edition-navigation { gap: 4px 20px; }
    section.edition-overview { grid-template-columns: 1fr; gap: 28px; padding-top: 32px; padding-bottom: 36px; }
    .overview-copy h2, .section-heading h2 { font-size: 1.75rem; }
    .edition-status { padding: 22px; }
    section.edition-focus, section.edition-archive { padding-top: 36px; padding-bottom: 36px; }
    .focus-area { grid-template-columns: 1fr; gap: 12px; }
    .edition-years { gap: 10px; }
    .edition-years a { min-width: 84px; }
  }
</style>
